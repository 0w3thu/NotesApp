<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7"
    tools:context=".UpdateNoteActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnUpdateBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_back"
            app:tint="@color/blue"
            android:contentDescription="Back"/>

        <!-- Spacer pushes Save button to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnUpdateSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:background="@android:color/transparent"/>

    </LinearLayout>


    <!-- Note Title -->
    <EditText
        android:id="@+id/etpUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/blue_border"
        android:padding="12dp"
        android:hint="Title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textColorHint="#A0A0A0"
        android:inputType="textCapSentences"/>


    <!-- Note Content -->
    <EditText
        android:id="@+id/etUpdateContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/blue_border"
        android:padding="12dp"
        android:gravity="top"
        android:hint="Start typing..."
        android:inputType="textMultiLine|textCapSentences"
        android:textSize="18sp"
        android:textColor="#000000"
        android:textColorHint="#A0A0A0"
        android:scrollbars="vertical"/>

</LinearLayout>
